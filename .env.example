# Copiez ce fichier en .env et collez la clé API fournie par l'école.
# Ne committez JAMAIS le fichier .env.
OPENAI_API_KEY=

# Modèles. Les noms changent souvent : l'enseignant vous indique ceux du jour.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Pour travailler sans rien dépenser : lancez `npm run mock` puis décommentez la ligne suivante.
# OPENAI_BASE_URL=http://localhost:4010/v1

# --- Blocs optionnels ------------------------------------------------------
# Multimodal (bloc D) : l'enseignant vous indique les modèles du jour.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Coûts (bloc A) : recopiez les prix du jour de OPENAI_MODEL, en dollars par million de tokens.
# PRIX_ENTREE=
# PRIX_ENTREE_CACHE=
# PRIX_SORTIE=
